# Obtain from @BotFather. Never commit a real token.
BOT_TOKEN=
# Optional dead-man switch (e.g. a healthchecks.io ping URL). Pinged every minute only while
# workers are alive, source data is fresh, and no delivery is overdue. Leave blank to disable.
HEALTHCHECK_PING_URL=
# Use a long random password containing letters and numbers.
POSTGRES_PASSWORD=replace_with_a_long_random_password
# For running Python outside Docker; Compose sets its own internal connection URL.
DATABASE_URL=postgresql://iett:replace_with_a_long_random_password@localhost:5432/iett
POLL_INTERVAL_SECONDS=60
POLL_CONCURRENCY=2
HTTP_TIMEOUT_SECONDS=10
OUTAGE_AFTER_SECONDS=600
STALE_AFTER_SECONDS=180
HISTORY_RETENTION_DAYS=90
MAX_SUBSCRIPTIONS=20
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
LOG_LEVEL=INFO
